<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gera <Assembly>.api.json (API pública + documentação XML) para o site de documentação.
       Lê a DLL só como metadados: não precisa carregar o jogo nem o MelonLoader. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ApiExtractor</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApiExtractor.Tests" />
  </ItemGroup>

</Project>
